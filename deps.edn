{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        ;; Native checkpoints, construction recovery and reactive lifetimes.
        org.replikativ/spindel {:mvn/version "0.1.148"}
        ;; Forkable worlds; static-methods value paths and merge-opts permissions.
        org.replikativ/sci {:mvn/version "0.15.59-replikativ.5"}
        ;; Direct CPS dependency; published under org.replikativ, namespaces unchanged.
        org.replikativ/partial-cps {:mvn/version "0.1.69"}
        ;; Exact Geschichte checkpoints and portable checkpoint origin validation.
        org.replikativ/yggdrasil {:mvn/version "0.3.52"
                                  :exclusions [org.babashka/sci]}
        ;; Listener ACK fix: a throwing observer cannot strand a committed publication.
        org.replikativ/datahike {:mvn/version "0.8.1910"}
        ;; Keep the direct blob-store dependency aligned with Datahike.
        org.replikativ/konserve {:mvn/version "0.9.394"}
        ;; Canonical resource account identities without database initialization.
        org.replikativ/kontor {:mvn/version "0.1.40"}
        ;; Authoritative virtual filesystem and Git; exact-basis publication.
        org.replikativ/geschichte {:mvn/version "0.1.25"}
        com.taoensso/telemere {:mvn/version "1.2.1"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      lambdaisland/kaocha-junit-xml {:mvn/version "1.17.101"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         ;; Cross-world state access must fail instead of merely warning.
         :jvm-opts ["-Xmx1500m" "-Dspindel.missing-state=throw"]
         :main-opts ["-m" "kaocha.runner"]}

  :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}}
         :jvm-opts ["-Xmx1500m"]
         :main-opts ["-m" "nrepl.cmdline" "--interactive"]}

  ;; Datahike's local default paths omit the secondary-index adapters.
  ;; Older checkouts still depend on the former is.simm/partial-cps coordinate.
  :local {:extra-paths ["../datahike/src-secondary"]
          :extra-deps {org.replikativ/sci {:local/root "../sci"}
                       org.replikativ/spindel {:local/root "../spindel"
                                               :exclusions [is.simm/partial-cps]}
                       org.replikativ/yggdrasil {:local/root "../yggdrasil"
                                                 :exclusions [is.simm/partial-cps]}
                       org.replikativ/datahike {:local/root "../datahike"
                                                :exclusions [is.simm/partial-cps]}}}

  :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :jvm-opts ["-Xmx1500m"]
           :main-opts ["-m" "cljfmt.main" "check" "src" "test"]}
  :ffix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
         :jvm-opts ["-Xmx1500m"]
         :main-opts ["-m" "cljfmt.main" "fix" "src" "test"]}}}
