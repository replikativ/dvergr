;; Dvergr Model Registry
;; Edit this file to add/modify models without changing source code.
;; Loaded at startup via (registry/load-models-resource!).
;;
;; Availability verified 2026-05-15 via direct chat-completion probes
;; (the /v1/models endpoint under-reports on this account). Models that
;; return HTTP 404 "Model not found, inaccessible, and/or not deployed"
;; are intentionally absent: kimi-k2-thinking, glm-5, qwen3-8b.

{:models
 {;; ── Fireworks (OpenAI-compatible) ──────────────────────────────────────────

  ;; ─── Kimi family ───────────────────────────────────────────────────────────

  "accounts/fireworks/models/kimi-k2p6"
  {:name "Kimi K2.6"
   :provider :fireworks
   :api-type :openai-chat
   ;; :vision — verified deployed + accurate on this account (probe 2026-07-05);
   ;; the dvergr.media.vision default. Reasoning model, so give vision/extract a
   ;; generous max-tokens (it spends output budget thinking before the answer).
   :capabilities #{:tools :vision :streaming}
   :context 262144
   :max-output 8192
   :pricing {:input 0.95 :cache-read 0.10 :output 4.00}
   ;; Kimi family on Fireworks: temperature fixed at 1.0 (immutable),
   ;; top_p default 0.95; same tool-id quirks as K2.5.
   :quirks {:tool-id-in-every-chunk? true
            :kimi-tool-id-format? true
            :default-top-p 0.95}}

  "accounts/fireworks/models/kimi-k2p5"
  {:name "Kimi K2.5"
   :provider :fireworks
   :api-type :openai-chat
   ;; :vision — the fallback vision model (see the Vision section below).
   :capabilities #{:tools :vision :streaming}
   :context 262144
   :max-output 8192
   :pricing {:input 0.60 :cache-read 0.10 :output 3.00}
   ;; K2.5 requires temperature=1.0 (immutable on Fireworks), top_p=0.95
   :quirks {:tool-id-in-every-chunk? true
            :kimi-tool-id-format? true
            :default-top-p 0.95}}

