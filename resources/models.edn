  ;; intermittently leaks it into `content` with empty tool_calls (stranded Vár's
  ;; intake run on 5.1). `:glm-tool-format?` turns on recovery+scrub in the
  ;; openai adapter (dvergr.model.quirks). 5.2 runs the structured path more
  ;; reliably but the leak is intermittent, so the defense stays on for both.

  "accounts/fireworks/models/glm-5p3"
  {:name "GLM 5.3"
   :provider :fireworks
   :api-type :openai-chat
   :capabilities #{:tools :streaming}
   :context 1048573
   :max-output 16384
   :pricing {:input 1.40 :cache-read 0.26 :output 4.40}
